<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.0.1</Version>
    <TargetFramework>net472</TargetFramework>
    <Platforms>x64</Platforms>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ArcherReposition.MCM</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- 与主 DLL 同目录：主 DLL 运行时反射 LoadFrom 本程序集 -->
    <OutputPath>..\..\bin\Win64_Shipping_Client\</OutputPath>
    <GameFolder>$(BANNERLORD_GAME_DIR)</GameFolder>
    <GameFolder Condition="'$(GameFolder)' == ''">E:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord</GameFolder>
    <GameBinariesFolder Condition="Exists('$(GameFolder)\bin\Win64_Shipping_Client\Bannerlord.exe')">Win64_Shipping_Client</GameBinariesFolder>
  </PropertyGroup>

  <ItemGroup>
    <!-- 仅 Adapter DLL 引用 MCM；主 DLL 引用表保持零 MCM（否则无 MCM 时加载 conflict） -->
    <Reference Include="MCMv5">
      <HintPath>$(GameFolder)\Modules\Bannerlord.MBOptionScreen\bin\$(GameBinariesFolder)\MCMv5.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Bannerlord.MBOptionScreen">
      <HintPath>$(GameFolder)\Modules\Bannerlord.MBOptionScreen\bin\$(GameBinariesFolder)\Bannerlord.ModuleLoader.Bannerlord.MBOptionScreen.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArcherReposition.csproj" />
  </ItemGroup>

</Project>
